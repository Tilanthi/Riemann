=== REPLICATION: c0 with a_used = the #120 value (should reproduce the published c0) ===
  17-rung  m1's 11 + m2's 6   (m2 c30 published fit) K=6  c0 = -1.63339469783e-15   maxres = 7.006e-10
  17-rung  m1's 11 + m1's 6   (m1 heat86b V1 fit)    K=6  c0 = -1.63339469783e-15   maxres = 7.006e-10
  6-alone  m2's c30 six                              K=3  c0 = -1.62341182589e-15   maxres = 1.938e-12
  6-alone  m1's heat86b six                          K=3  c0 = -1.62341182589e-15   maxres = 1.938e-12
  6-alone  m2's c31b six (OUT OF SAMPLE, finer)      K=3  c0 = -1.62157937856e-15   maxres = 7.441e-12
  12 fine  m2 c30 + m2 c31b                          K=6  c0 =  -1.6215736339e-15   maxres = 8.067e-12
  12 fine  m1 heat86b + m2 c31b                      K=6  c0 =  -1.6215736339e-15   maxres = 8.067e-12

=== BIAS: c0 with a_used = the LADDER-FREE a  (an unbiased estimator must return 0) ===
  17-rung  m1's 11 + m2's 6   (m2 c30 published fit) K=6  c0 = -1.24108239478e-17   maxres = 7.006e-10
  17-rung  m1's 11 + m1's 6   (m1 heat86b V1 fit)    K=6  c0 = -1.24108239478e-17   maxres = 7.006e-10
  6-alone  m2's c30 six                              K=3  c0 = -2.42795200955e-18   maxres = 1.938e-12
  6-alone  m1's heat86b six                          K=3  c0 = -2.42795200955e-18   maxres = 1.938e-12
  6-alone  m2's c31b six (OUT OF SAMPLE, finer)      K=3  c0 = -5.95504681082e-19   maxres = 7.441e-12
  12 fine  m2 c30 + m2 c31b                          K=6  c0 = -5.89760020923e-19   maxres = 8.067e-12
  12 fine  m1 heat86b + m2 c31b                      K=6  c0 = -5.89760020923e-19   maxres = 8.067e-12

=== TEST 2: does swapping the LINEAGE of the six fine rungs move c0 at all? ===
  K=5: m2's six -> -1.92723028429588e-15
       m1's six -> -1.92723028429588e-15
       |difference| = 7.48722e-40   rel = 3.88497e-25
  K=6: m2's six -> -1.63339469782662e-15
       m1's six -> -1.63339469782662e-15
       |difference| = 8.25734e-40   rel = 5.05532e-25
  K=7: m2's six -> -1.6253100565515e-15
       m1's six -> -1.6253100565515e-15
       |difference| = 9.38848e-40   rel = 5.77642e-25

